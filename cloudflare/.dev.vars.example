# Local-dev-only secrets (for `wrangler dev` / `npm run dev`). Copy this file
# to `.dev.vars` (gitignored) and fill in your own values — `.dev.vars` is
# never used for the deployed Worker, which reads secrets set via
# `wrangler secret put` instead (see ../README.md).
GUEST_TOKEN_SECRET=dev-only-guest-secret-change-me
ADMIN_TOKEN_SECRET=dev-only-admin-secret-change-me
ADMIN_PASSWORD=dev-only-password
